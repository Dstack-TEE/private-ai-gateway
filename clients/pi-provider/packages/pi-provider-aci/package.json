{
  "name": "@phala/pi-provider-aci",
  "version": "0.2.0",
  "description": "Vendor-neutral Pi provider for private-ai-gateway (ACI): attested TLS (SPKI) pinning (prevention); optional on-demand receipt/session inspection",
  "keywords": [
    "ai-provider",
    "attestation",
    "confidential-ai",
    "confidential-computing",
    "llm",
    "llm-provider",
    "aci",
    "private-ai",
    "private-ai-gateway",
    "gateway",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-provider",
    "tee",
    "verifiable"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pre-commit": "prek run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@phala/aci-verifier": "file:../../../verifier-ts",
    "undici": "8.5.0"
  }
}
