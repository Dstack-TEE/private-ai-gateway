{
  "name": "pi-provider-redpill",
  "version": "0.4.0",
  "description": "Redpill AI for Pi with verified ACI transport and per-response receipt verification",
  "keywords": [
    "ai-provider",
    "attestation",
    "confidential-ai",
    "pi",
    "pi-provider",
    "redpill",
    "tee",
    "verifiable"
  ],
  "homepage": "https://github.com/Dstack-TEE/private-ai-gateway/tree/main/clients/pi-provider/packages/pi-provider-redpill",
  "bugs": "https://github.com/Dstack-TEE/private-ai-gateway/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dstack-TEE/private-ai-gateway.git",
    "directory": "clients/pi-provider/packages/pi-provider-redpill"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@phala/aci-provider": "^0.4.0",
    "@phala/pi-provider-aci": "^0.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.3 <0.85.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
