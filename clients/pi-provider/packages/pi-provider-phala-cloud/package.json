    "@earendil-works/pi-tui": ">=0.83.0 <0.85.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build"
  }
