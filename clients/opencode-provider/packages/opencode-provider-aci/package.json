{
  "name": "@phala/opencode-provider-aci",
  "version": "0.1.0",
  "description": "Vendor-neutral opencode provider for private-ai-gateway (ACI): attested TLS (SPKI) pinning + per-response receipt verification",
  "keywords": [
    "aci",
    "ai-provider",
    "attestation",
    "confidential-ai",
    "confidential-computing",
    "gateway",
    "llm",
    "llm-provider",
    "opencode",
    "opencode-plugin",
    "opencode-provider",
    "private-ai",
    "private-ai-gateway",
    "tee",
    "verifiable"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "core.ts",
    "src",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./core": "./core.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pre-commit": "prek run"
  },
  "dependencies": {
    "@phala/aci-verifier": "file:../../../verifier-ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  }
}
