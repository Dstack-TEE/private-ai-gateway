{
  "name": "private-ai-gateway-clients",
  "version": "0.7.3",
  "private": true,
  "description": "ACI TypeScript verifier and verified fetch client",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "verifier-ts"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:bun": "npm run test:bun -w @phala/aci-verifier",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "pack:check": "npm run pack:check --workspaces --if-present",
    "lint:packages": "npm run lint:package -w @phala/aci-verifier"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "npm@11.16.0"
}
