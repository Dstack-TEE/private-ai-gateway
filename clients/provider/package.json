{
  "name": "@phala/aci-provider",
  "version": "0.7.2",
  "description": "Framework-neutral model provider for Attested Confidential Inference gateways",
  "keywords": [
    "aci",
    "ai-provider",
    "attestation",
    "coding-agent",
    "confidential-ai",
    "llm",
    "tee"
  ],
  "homepage": "https://github.com/Dstack-TEE/private-ai-gateway/tree/main/clients/provider",
  "bugs": "https://github.com/Dstack-TEE/private-ai-gateway/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dstack-TEE/private-ai-gateway.git",
    "directory": "clients/provider"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./phala-cloud": {
      "types": "./dist/phala-cloud.d.ts",
      "import": "./dist/phala-cloud.js",
      "default": "./dist/phala-cloud.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js",
      "default": "./dist/profiles.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check && npm test && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@phala/aci-verifier": "^0.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20.18.1"
  }
}
