{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Private AI Proxy",
  "version": "0.2.0-beta.0",
  "identifier": "org.dstack.private-ai-proxy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Private AI Proxy",
        "width": 1052,
        "height": 840,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "hiddenTitle": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' https://img.clerk.com https://images.clerk.dev https://clerk.redpill.ai; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' https://img.clerk.com https://images.clerk.dev https://clerk.redpill.ai; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Verified local AI proxy",
    "longDescription": "Routes coding agents through a hardware-verified confidential AI service with a signed proof for every answer.",
    "publisher": "Dstack TEE",
    "homepage": "https://dstack.org",
    "externalBin": [
      "binaries/private-ai-proxy",
      "binaries/private-ai-proxy-service",
      "binaries/private-ai-proxy-helper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "installer/brand-dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 180,
          "y": 230
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 230
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/brand-header.bmp",
        "sidebarImage": "installer/brand-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/windows.nsh",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "org.dstack.private-ai-proxy"
        ]
      }
    }
  }
}
