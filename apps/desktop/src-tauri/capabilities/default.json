{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions shared by application windows",
  "windows": [
    "main",
    "profiles",
    "profile-editor",
    "privacy",
    "local-api",
    "web-ui",
    "usage-proof",
    "local-api-example",
    "notifications"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-show-edit-menu",
    "allow-get-appearance",
    "allow-show-error-alert",
    "allow-get-state"
  ]
}
