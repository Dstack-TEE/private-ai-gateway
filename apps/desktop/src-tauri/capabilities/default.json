{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "profiles",
    "profile-editor",
    "privacy",
    "local-api",
    "usage-proof",
    "update-progress",
    "local-api-example",
    "notifications"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
