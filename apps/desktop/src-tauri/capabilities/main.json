{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Private AI Proxy main application surface",
  "windows": ["main"],
  "permissions": [
    "allow-start-backend-service",
    "allow-reset-settings",
    "allow-export-diagnostics",
    "allow-get-notification-settings",
    "allow-request-notification-permission",
    "allow-set-appearance",
    "allow-prepare-update",
    "allow-set-update-channel",
    "allow-restart-to-update",
    "allow-get-launch-preferences",
    "allow-set-launch-preference",
    "allow-start-gateway",
    "allow-stop-gateway",
    "allow-copy-text",
    "allow-open-native-dialog",
    "allow-main-window-ready",
    "allow-open-agent-website",
    "allow-query-usage",
    "allow-open-about-link",
    "allow-get-client-key",
    "allow-list-agents",
    "allow-preview-agent-connection",
    "allow-apply-agent-connection",
    "allow-get-cli-registration",
    "allow-set-cli-registration",
    "allow-stop-all-and-quit",
    "allow-account-balance",
    "allow-open-top-up",
    "allow-open-organization"
  ]
}
