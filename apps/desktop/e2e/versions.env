# Defaults for the live end-to-end test, one per line. run.sh resolves latest
# before starting the container. Set an exact version here or in the environment
# to reproduce a run; the environment takes precedence.
NODE_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
OPENCODE_VERSION=latest
OPENCODE_V2_VERSION=latest
PI_VERSION=latest
BUN_VERSION=latest
OH_MY_PI_VERSION=latest
DSH_VERSION=latest
OPENCLAW_VERSION=latest
HERMES_VERSION=latest
