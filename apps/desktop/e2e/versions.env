# Versions the live end-to-end test installs, one per line (docker --env-file
# format: no quotes, no inline comments). Bump a version in its own PR.
NODE_VERSION=24.21.0
CLAUDE_CODE_VERSION=2.1.283
# The Codex baseline the app supports: agent-bridge/resources/codex/manifest.json.
CODEX_VERSION=0.157.1
OPENCODE_VERSION=1.18.32
PI_VERSION=0.87.1
OH_MY_PI_VERSION=18.3.5
# The OpenClaw installer also reads OPENCLAW_VERSION itself.
OPENCLAW_VERSION=2026.9.6
# A Hermes release tag; the test runs that tag's own scripts/install.sh.
HERMES_VERSION=v2026.9.24
