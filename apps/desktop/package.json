{
  "name": "private-ai-proxy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Tauri desktop app for the ACI local verifying proxy",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "prepare:macos-icon": "node scripts/prepare-macos-icon.mjs",
    "build": "npm run prepare:brand && npm run prepare:macos-icon && vite build",
    "build:sidecars": "node scripts/bundle-sidecars.mjs",
    "build:sidecars:debug": "node scripts/bundle-sidecars.mjs --debug",
    "package:cli": "node scripts/package-cli.mjs",
    "check": "npm run prepare:brand && tsc --noEmit",
    "dev": "npm run prepare:brand && npm run build:sidecars:debug && tauri dev --config src-tauri/tauri.brand.conf.json",
    "dev:web": "npm run prepare:brand && vite --host 127.0.0.1 --port 1420",
    "dist": "node scripts/dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "tauri": "tauri",
    "test:renderer": "playwright test",
    "test:release": "node --test scripts/create-update-manifest.test.mjs scripts/package-cli.test.mjs scripts/release-channel.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "bmp-js": "^0.1.0",
    "semver": "^7.8.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
