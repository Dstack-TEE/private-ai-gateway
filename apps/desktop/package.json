{
  "name": "private-ai-gateway-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri menu bar GUI for the ACI local verifying proxy",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:native": "node scripts/bundle-native.mjs",
    "build:native:debug": "node scripts/bundle-native.mjs --debug",
    "dev": "npm run build:native:debug && tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "dist": "npm run build:native && tauri build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:renderer": "playwright test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
