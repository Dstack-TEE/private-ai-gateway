{
  "name": "private-ai-proxy-desktop",
  "version": "0.2.0-beta.0",
  "private": true,
  "description": "Private AI Proxy desktop app, web UI and release tooling",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "refresh:codex-catalog": "node scripts/refresh-codex-catalog.mjs",
    "prepare:macos-icon": "node scripts/prepare-macos-icon.mjs",
    "build": "npm run prepare:macos-icon && vite build",
    "build:web": "vite build --mode web",
    "build:sidecars": "node scripts/bundle-sidecars.mjs",
    "build:sidecars:debug": "node scripts/bundle-sidecars.mjs --debug",
    "package:cli": "node scripts/package-cli.mjs",
    "check": "tsc --noEmit && npm run test:agents",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "dev": "npm run build:sidecars:debug && tauri dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "dist": "node scripts/dist.mjs",
    "dist:app-store": "node scripts/dist.mjs --distribution mac-app-store",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "test:agents": "node --test scripts/agent-integrations.test.mjs",
    "test:probe": "node --test scripts/probe-model-endpoints.test.mjs",
    "test:release": "node --test scripts/create-update-manifest.test.mjs scripts/package-app-store.test.mjs scripts/package-cli.test.mjs scripts/package-linux.test.mjs scripts/npm-install.test.mjs scripts/npm-registry.test.mjs scripts/package-npm.test.mjs scripts/release-channel.test.mjs scripts/release-workflow.test.mjs",
    "package:npm": "node scripts/package-npm.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-table": "^9.2.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eventsource-parser": "^3.1.1",
    "js-yaml": "4.3.2",
    "semver": "^7.8.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
